# Copy file ini jadi .env.local
# cp .env.local.example .env.local

# Aktifkan mock auth (skip real backend login + gunakan seed data lokal)
# EXPO_PUBLIC_MOCK_AUTH=true

# Catatan: untuk iOS simulator & Android emulator, API URL default sudah
# otomatis (localhost / 10.0.2.2). Set EXPO_PUBLIC_API_URL hanya jika run di
# physical device, contoh: http://192.168.18.167:8000/api
