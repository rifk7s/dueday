# Copy file ini jadi .env.local
# cp .env.local.example .env.local

# Aktifkan mock auth (skip real backend login + gunakan seed data lokal)
# EXPO_PUBLIC_MOCK_AUTH=true

# Catatan: API URL ke-resolve otomatis untuk iOS simulator, Android emulator,
# DAN physical device via Expo Go (asal HP & laptop di Wi-Fi yang sama) —
# tidak perlu set apa-apa, tinggal scan QR.
#
# Set EXPO_PUBLIC_API_URL hanya untuk setup non-standar: pakai
# `expo start --tunnel`, backend di mesin/port lain, atau API staging.
# Contoh: http://192.168.x.x:8000/api
