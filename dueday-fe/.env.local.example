# Copy file ini jadi .env.local
# cp .env.local.example .env.local

# Aktifkan mock auth (skip real backend login + gunakan seed data lokal)
# EXPO_PUBLIC_MOCK_AUTH=true

# URL backend API. Pilih sesuai target run:
# - iOS simulator:        http://localhost:8000/api
# - Android emulator:     http://10.0.2.2:8000/api
# - Physical device:      http://<IP-LAN-Mac>:8000/api  (contoh: http://192.168.18.167:8000/api)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
